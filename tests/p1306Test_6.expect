#include <tuple>

struct Point
{
  int x;
  char y;
};


template<typename T>
int Sum(T & range)
{
  int sum = {};
  template for(auto & e : range){
    sum = sum + static_cast<int>(e);
  }
  return static_cast<int &&>(sum);
}

